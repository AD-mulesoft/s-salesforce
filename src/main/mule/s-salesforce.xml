						<ee:transform doc:name="errorList" doc:id="1094f37f-ef6d-4fbe-82e5-885fa03141f8" >
							<ee:message />
							<ee:variables >
								<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/json
---
400]]></ee:set-variable>
								<ee:set-variable variableName="errorList" ><![CDATA[%dw 2.0
output application/json
---
[{
	"id": payload.opportunity_Id_Commerce__c ++ " - " ++ payload.opportunity_Name,
	"mensaje": error.description
}]

//{
//	"id": payload.opportunity_Id_Commerce__c,
//	"message": error.description
//}
]]></ee:set-variable>
							</ee:variables>
