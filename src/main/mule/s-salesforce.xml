						<ee:transform doc:name="dataToBrevo" doc:id="61716fdf-67f5-43b2-85ad-224f0c02557d" >
							<ee:message />
							<ee:variables >
								<ee:set-variable variableName="dataToBrevo" ><![CDATA[%dw 2.0
output application/json

var emailTo = (p('ecommerce.quote.error.emailTo') splitBy (",")) map () -> {
			    "email": $
				}
---
{
	"to": emailTo,
	"templateId": p('ecommerce.quote.error.templateId') as Number,
	"params": {
		"proceso": p('ecommerce.quote.error.proceso-quote'),
		"items": vars.errorList
	}
}]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="brevoSendEmail_subFlow" doc:id="9e61e880-73bd-458f-871c-a8fd4ae4d31b" name="brevoSendEmail_subFlow" />
					</on-error-propagate>
				</error-handler>
			</try>
		</async>
        <ee:transform doc:name="payload" doc:id="9de2ef3c-ce9b-4a0c-bc7d-8b8379a2e6c9">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
"OK"]]></ee:set-payload>
			</ee:message>
		</ee:transform>
        <logger level="INFO" doc:name="END" doc:id="823f5753-3e07-4665-beab-a5a6bd84361c" message="END post:\quote" />
