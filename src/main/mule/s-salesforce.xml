	<flow name="Send_Client" doc:id="fc8b3036-9042-4f5d-a78e-dcde71250dad" maxConcurrency="1">
		<salesforce-pub-sub:subscribe-channel-listener doc:name="Subscribe channel listener" doc:id="86683a6e-17fd-49c2-a47b-324cd207c6b3" config-ref="Salesforce_PubSub_Config" channelName="/event/VLC_Registros_a_SAP__e">
			<salesforce-pub-sub:replay-option >
				<salesforce-pub-sub:latest />
			</salesforce-pub-sub:replay-option>
		</salesforce-pub-sub:subscribe-channel-listener>
		<logger level="INFO" doc:name="INIT" doc:id="7df3f13d-b853-4a4d-a46a-45a96b899e8e" message="INIT Subscribe"/>
		<logger level="INFO" doc:name="payload" doc:id="367514ee-e8f5-49e4-884b-c4dafb349e62" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]"/>
		<ee:transform doc:name="Init vars" doc:id="e452ddc7-62ae-425a-ae44-2541fe3c35fb" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="sfId" ><![CDATA[%dw 2.0
output application/json
---
payload.event.Id__c]]></ee:set-variable>
				<ee:set-variable variableName="objectType" ><![CDATA[%dw 2.0
output application/json
---
payload.event.sObject__c ++ "-" ++ payload.event.Operation__c]]></ee:set-variable>
				<ee:set-variable variableName="sfObject" ><![CDATA[%dw 2.0
output application/json
---
payload.event.sObject__c]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Choice" doc:id="9b7c6ed9-b8ce-4c4e-a511-b5cf3b59d75b" >
			<when expression='#[vars.objectType == "Account-Insert" or vars.objectType == "Tiernda_Obra__c-Insert"]'>
				<ee:transform doc:name="Query + dwSelector" doc:id="be590633-bbd2-4371-b073-121dad8935d4">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="dwSelector"><![CDATA[%dw 2.0
output application/java 
var fileName= "modules/salesforce/$(vars.objectType).dwl"
---
readUrl("classpath://" ++ fileName,"text/plain")]]></ee:set-variable>
				<ee:set-variable variableName="sfQuery"><![CDATA[%dw 2.0
output application/json
---
p('sfToSap.query.' ++ vars.objectType) replace "REPLACEID" with (vars.sfId)]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
			</when>
			<when expression='#[vars.objectType == "Account-Update" or vars.objectType == "Tiernda_Obra__c-Update"]'>
				<ee:transform doc:name="Query" doc:id="b486ef34-6fa9-4c5a-9a9b-64a8129d7263">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="sfQuery"><![CDATA[%dw 2.0
output application/json

var historyField = if (vars.objectType == "Account-Update") "VLC_Account__c"
					else if (vars.objectType == "Tiernda_Obra__c-Update") "VLC_Tienda_Obra__c"
					else ""
//vars.objectType == "Account-Update" or vars.objectType == "Tiernda_Obra__c-Update"
---
"SELECT Id, VLC_Objeto__c, VLC_Account__c, VLC_Tienda_Obra__c, VLC_Campo__c, VLC_Estado__c, VLC_Detalle_Estado__c, VLC_Fecha_Envio__c, VLC_External_ID__c FROM Field_History__c WHERE VLC_Estado__c IN ('Pendiente','Error') AND " ++
historyField ++ " = '" ++ vars.sfId ++ "' AND IsDeleted = false"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<logger level="INFO" doc:name="sfQuery" doc:id="56f33382-2a48-4a68-92b3-311d31bba6fe" message="#[vars.sfQuery]"/>
				<salesforce:query-all doc:name="sfQuery" doc:id="83ac291c-cb23-499b-aab7-6718afe9c588" config-ref="Salesforce_Config" target="sfField_History__c">
					<salesforce:salesforce-query ><![CDATA[#[vars.sfQuery]]]></salesforce:salesforce-query>
				</salesforce:query-all>
				<logger level="INFO" doc:name="sfField_History__c" doc:id="cda24f7c-7756-421d-98e3-2add543eb1e7" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.sfField_History__c]" />
				<ee:transform doc:name="Query + dwSelector" doc:id="be147e3b-33cd-4e56-b372-44a6fc630c74" >
					<ee:message />
					<ee:variables >
						<ee:set-variable variableName="dwSelector" ><![CDATA[%dw 2.0
output application/java 
var fileName= "modules/salesforce/$(vars.objectType).dwl"
---
readUrl("classpath://" ++ fileName,"text/plain")]]></ee:set-variable>
						<ee:set-variable variableName="sfQuery" ><![CDATA[%dw 2.0
output application/json
---
p('sfToSap.query.' ++ vars.objectType) replace "REPLACEID" with (vars.sfId) replace " REPLACEFIELDS" with (
    if(!isEmpty(vars.sfField_History__c.VLC_Campo__c)) (", " ++ ((vars.sfField_History__c.VLC_Campo__c joinBy ", ") default ""))
    else "")]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
		</choice>
		<salesforce:query-all doc:name="sfQuery" doc:id="806c7074-1465-41ca-a117-3b734fdda66a" config-ref="Salesforce_Config" target="sfRecord" targetValue="#[payload[0]]">
			<salesforce:salesforce-query ><![CDATA[#[vars.sfQuery]]]></salesforce:salesforce-query>
		</salesforce:query-all>
		<logger level="INFO" doc:name="sfRecord" doc:id="a7201e5e-204c-4a00-9db4-3b1d7edd61c4" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.sfRecord]" />
		<salesforce:query-all doc:name="sfTipo" doc:id="a9687a02-1919-4817-a1e3-a91513c272c9" config-ref="Salesforce_Config" target="sfTipo">
