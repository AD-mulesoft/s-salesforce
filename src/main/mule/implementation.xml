			<choice doc:name="Choice" doc:id="58b421bb-56e8-404e-a837-c5e7b0a40095" >
				<when expression="#[!isEmpty(payload) and !isEmpty(vars.sfUrl)]">
					<logger level="INFO" doc:name="Logger" doc:id="e8f1722b-7bed-40ce-a2ec-d9a83ad000b3" message="Sending records to Brevo"/>
					<ee:dynamic-evaluate doc:name="dwSelector" doc:id="f3474b36-74c2-426e-9865-769ced2b3057" expression="#[vars.dwSelector]" />
					<logger level="INFO" doc:name="sizeOf(payload)" doc:id="b9ba4901-7a2c-46f3-9d78-f0cc6e8117dd" message='#["Records count filtered by email: " ++ sizeOf(payload.surveyRecords)]' />
					<logger level="DEBUG" doc:name="payload" doc:id="65287b67-0ea3-4fec-a3ba-1c05179ccc59" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]" />
					<flow-ref doc:name="brevoSendSurvey_subFlow" doc:id="e94e23ac-1eb4-4500-80f0-39a1ab533a11" name="brevoSendSurvey_subFlow"/>
