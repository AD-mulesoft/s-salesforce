	<sub-flow name="sendContacts_subFlow" doc:id="2ffa89eb-639d-435c-8630-57460c407cdd" >
		<until-successful maxRetries="3" doc:name="Until Successful" doc:id="6047a075-e3b1-46c1-94da-52c8c355bbd1" millisBetweenRetries="5000">
			<salesforce:query-all doc:name="Query all" doc:id="cfc7ac05-7bca-4d85-ade6-29ac70d23013" config-ref="Salesforce_Config">
			<salesforce:salesforce-query><![CDATA[#[p('salesforce.query.importContacts')]]]></salesforce:salesforce-query>
		</salesforce:query-all>
		</until-successful>
		<logger level="INFO" doc:name="payload" doc:id="8a1c6ff9-0b66-4ee9-b412-34e7a7120cfe" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]"/>
		<choice doc:name="Choice" doc:id="458cc046-3be7-4f29-8681-a46fade8ad9f" >
			<when expression="#[!isEmpty(payload)]">
				<ee:transform doc:name="Format Brevo Req" doc:id="193e69fc-059a-4ff9-892e-cc37a8eb3c5a">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json

var contactMap = payload map () -> {
	"email": $.Email default "",
 	"id": $.Id default "",
	"nombre": $.FirstName default "",
	"apellido": $.LastName default "",
	"cargo": $.Title default "",
	"ownerEmpresa": $.Propietario_Cuenta_asociada__c default "",
	"area": $.rea_de_Trabajo_consolidado__c default "",
	"tipoCuenta": $.Tipo_de_Cuenta_Asociada__c default "",
	"rut": $.Rut__c default "",
	"empresa": $.Account.Name default "",
	"ownerContacto": $.Owner.Name default "",
	"createdDate": $.CreatedDate  default "",
	"phone": $.Phone default "",
	"mobilePhone": $.Phone default ""
}
---
{
	"listIds": p('brevo.listIds.marketing') splitBy (",") map ($ as Number ),
	"contacts": contactMap
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
				<logger level="INFO" doc:name="payload" doc:id="2c4b4847-de30-4c42-a7de-308213b8c645" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]" />
				<flow-ref doc:name="importContacts_subFlow" doc:id="a5cbd290-c0ac-4215-bea4-76ec16b891ee" name="brevoImportContacts_subFlow"/>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="No records" doc:id="3e493bcb-e48d-4b45-862c-e82b7cf839e2" message="No records" />
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="sendSurvey_subFlow" doc:id="dcc0c713-ccbd-4d4c-8e06-d7bdff78343b" >
		<parallel-foreach doc:name="Parallel For Each p('survey.entity')" doc:id="73b47ca7-05ff-4803-bfba-5292bc46385b" collection="#[p('survey.entity') splitBy &quot;,&quot;]" maxConcurrency="1">
