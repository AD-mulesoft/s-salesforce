	<sub-flow name="postQuote_subFlow" doc:id="cb33ce73-65ee-476c-a7a6-317b4b15bfa1" >
		<choice doc:name="Choice" doc:id="4ebf433b-9bbb-4f5d-98be-d6bb5b90deb4" >
			<when expression="#[!isEmpty(payload.account_Rut__c)]">
				<ee:transform doc:name="Query Get Rut" doc:id="fc79b420-a6b0-4fc9-9ac3-f8722f7cf456">
			<ee:message>
			</ee:message>
					<ee:variables >
						<ee:set-variable variableName="sfAccount" ><![CDATA[%dw 2.0
output application/json
---
"SELECT id, Rut__c, RecordType.Name FROM Account WHERE isDeleted = false AND Rut__c = '" ++ (payload.account_Rut__c replace "." with ("")) ++ "'"
]]></ee:set-variable>
					</ee:variables>
		</ee:transform>
				<salesforce:query-all doc:name="sfAccount" doc:id="f1f6a1f7-18e3-4622-9f9e-63cab21edfd9" config-ref="Salesforce_Config" target="sfAccount">
					<salesforce:salesforce-query ><![CDATA[#[vars.sfAccount]]]></salesforce:salesforce-query>
				</salesforce:query-all>
				<logger level="INFO" doc:name="sfAccount" doc:id="ba1c75ea-564d-4b2e-8f79-5a30ca8f7fba" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.sfAccount]"/>
				<choice doc:name="Choice Account" doc:id="20d7d23a-8bf0-4235-aeab-baa24ee7c1fa" >
					<when expression='#[!isEmpty(vars.sfAccount) and vars.sfAccount[0].RecordType.Name != "Cuenta Para Cotizar"]'>
						<ee:transform doc:name="sfAccount.Id" doc:id="4b44c85b-dc71-4024-9034-1ad96667cbd4">
							<ee:message>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="sfAccount"><![CDATA[%dw 2.0
output application/json
---
vars.sfAccount[0].Id]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<logger level="INFO" doc:name="Rut Exists" doc:id="6b8ba19b-d7e4-43aa-8a09-80b4722055c9" message='#[%dw 2.0&#10;output application/json&#10;---&#10;"Rut " ++ payload.account_Rut__c ++ " exists in SF - Id: " ++ vars.sfAccount]'/>
