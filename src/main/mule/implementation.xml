	<sub-flow name="lead_GFK_subFlow" doc:id="ae375995-6b82-4dc1-9e2c-1f124d41242b" >
		<logger level="INFO" doc:name="sizeOf(payload)" doc:id="83b39f69-9a3b-48bd-b449-58fde2bba970" message='#["Received " ++ sizeOf(payload.data) ++ " Records"]' />
		<flow-ref doc:name="getComunas_subFlow" doc:id="fb972e41-7f4f-41a8-9aef-c04699ea04a4" name="getComunas_subFlow" target="sfComunas" />
		<ee:transform doc:name="dataToSalesforce - Add RT" doc:id="54a02dc1-46ea-4caa-9e28-81c90d8760de">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="sfExtId"><![CDATA[%dw 2.0
output application/java
---
p('ecommerce.leadGFK.sfExtId')]]></ee:set-variable>
				<ee:set-variable variableName="sfObject"><![CDATA[%dw 2.0
output application/java
---
p('ecommerce.leadGFK.sfObject')]]></ee:set-variable>
				<ee:set-variable variableName="dataToSalesforce" ><![CDATA[%dw 2.0
import * from dw::util::Values
output application/json

fun trunc40 (value) = if((!isEmpty(value)) and (sizeOf(value) > 39)) value[0 to 39] else value
fun trunc255 (value) = if((!isEmpty(value)) and (sizeOf(value) > 254)) value[0 to 254] else value

---
payload.data map (item,index) -> (
    (item 
    update ("Region__c") with ((vars.sfComunas filter (upper($.comuna) == upper(item.Comuna_Zona_de_transporte__c)))[0].region default "")
    update ("Comuna_Zona_de_transporte__c") with ((vars.sfComunas filter (upper($.comuna) == upper(item.Comuna_Zona_de_transporte__c)))[0].comuna default "")
    update ("LastName") with trunc40(item.LastName)
    update ("Nombre_Proyecto_GFK__c") with trunc255(item.Nombre_Proyecto_GFK__c)
    )
    ++ {"RecordType.Name": "Prospecto GFK"}
    ++ {"Status": "Abierto"}
    ++ {"LeadSource": "GFK"}
    )]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="sizeOf(dataToSalesforce)" doc:id="3f1aef7b-f464-4d66-bef6-81b38eb1b459" message='#["Send to Salesforce - " ++ sizeOf(vars.dataToSalesforce) ++ " Records"]' />
		<salesforce:create-job-bulk-api-v2 doc:name="Create job bulk api v 2" doc:id="3493ccb6-4cd8-4afc-9da4-1be324f09774" config-ref="Salesforce_Config" objectType="#[vars.sfObject]" externalIdFieldName="#[vars.sfExtId]" operation="upsert" target="sfJob" assignmentRuleId="01Q3m000000ks8WEAQ">
			<salesforce:s-objects ><![CDATA[#[%dw 2.0
output application/csv headerLineNumber = 0 , header = true , lineSeparator = "\n" , quoteValues = true , quoteHeader = true, encoding= 'UTF-8', escape="\""
---
vars.dataToSalesforce]]]></salesforce:s-objects>
		</salesforce:create-job-bulk-api-v2>
		<async doc:name="Async" doc:id="025eefc6-8223-4eb8-b8d9-548496ec4e4d" >
			<logger level="INFO" doc:name="Job Status" doc:id="cad85239-4c66-4a5f-ac57-27f90f711a51" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.sfJob]" />
			<ee:transform doc:name="Wait 10000" doc:id="808b22a1-1562-4d2a-a7cc-60df2da5c569">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="ignore"><![CDATA[%dw 2.0
import wait from dw::Runtime
output application/java
---
{} wait 10000]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
			<until-successful maxRetries="${ecommerce.leadGFK.retry}" doc:name="Until Successful" doc:id="6004b774-eac3-4cb2-ae92-72229fbb7dfb" millisBetweenRetries="${ecommerce.leadGFK.interval}">
			<salesforce:get-job-state-bulk-api-v2 doc:name="Get job state bulk api v 2" doc:id="69848eaa-e01e-45b5-ab6c-2ef50cb80ea1" config-ref="Salesforce_Config" id="#[vars.sfJob.Id]" />
			<choice doc:name="Choice" doc:id="27fb97c2-d8a3-4d76-97b0-38f09f7482d3">
			<when expression="#[payload.state == 'InProgress' or payload.state == 'UploadComplete' or payload.state == 'Open']">
				<logger level="INFO" doc:name="SF Job Status" doc:id="69ff8518-7f21-4406-ba00-ae9b7a99b564" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload.state]" />
				<raise-error doc:name="Raise error" doc:id="ea242ae4-6eb4-4437-a143-262399ac7466" type="ANY" description="Job not finished" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="SF Job Status" doc:id="682b0889-d935-4726-ba34-a06919bfdebc" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]" />
			</otherwise>
		</choice>
		</until-successful>
			<choice doc:name="Choice" doc:id="fe707dff-7bbf-4cca-9c2c-d993d2aef21b">
				<when expression="#[payload.state == 'JobComplete']">
				<salesforce:retrieve-job-failed-results-bulk-v2 doc:name="Retrieve job failed results bulk v 2" doc:id="f1c6d6bb-b158-4d9d-9b4d-a78e87821d52" config-ref="Salesforce_Config" id="#[vars.sfJob.Id]" />
				<ee:transform doc:name="Error list" doc:id="1f97860f-e531-406f-a46d-959b1f334f01">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Log Failed Records" doc:id="bd802eee-66b4-4c49-944d-db5e6a0bb6f9" message="#[%dw 2.0&#10;import * from dw::core::Arrays&#10;output application/json&#10;---&#10;take(payload,50)]" />
			</when>
			</choice>
		</async>
	</sub-flow>
