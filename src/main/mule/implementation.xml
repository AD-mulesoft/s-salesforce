	<sub-flow name="lead_Shopify_subFlow" doc:id="09872e84-d5e6-440b-adc9-b2f72dc553db" >
		<logger level="INFO" doc:name="sizeOf(payload)" doc:id="b9a966d6-6434-4005-9f7d-3dbefa955540" message='#["Received " ++ sizeOf(payload) ++ " Records"]'/>
		<ee:transform doc:name="Query IDs Lead" doc:id="2d1ac34a-d95d-4981-b836-a7340795e956" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="queryLeadId" ><![CDATA[%dw 2.0
output application/json
---
"SELECT Id, Id_Commerce__c, Status, IsConverted, Email FROM Lead WHERE Id_Commerce__c IN ('" ++ (
	if(sizeOf(payload) > 0)
		payload map(
			$.Id_Commerce__c
		) joinBy "','"
	else " "
) ++ "')"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="DEBUG" doc:name="queryLeadId" doc:id="0bd24ace-4b1e-4ab1-b70c-48f35e8ca4c5" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.queryLeadId]"/>
		<salesforce:query-all doc:name="Query all" doc:id="2f9b0242-eff4-4b43-9ac7-ecfdcf455eeb" config-ref="Salesforce_Config" target="listLeadId">
			<salesforce:salesforce-query ><![CDATA[#[vars.queryLeadId]]]></salesforce:salesforce-query>
		</salesforce:query-all>
		<logger level="DEBUG" doc:name="listLeadId" doc:id="cccddee0-b2f6-433a-b46b-0eef6d6baf56" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.listLeadId]"/>
		<ee:transform doc:name="dataToSalesforce - Filter Status" doc:id="9fb128d1-903c-410f-8b35-2cc36fb3db19">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var STATUS=["Abierto","Sin Gestion","Interesado"]
---
//payload map () -> (
//    $ ++ {"Status": (listLeadId filter (item,index) -> (item.Id_Commerce__c == $.Id_Commerce__c))[0].Status default ""}
//)
payload filter (item1) -> (sizeOf(vars.listLeadId filter (item2) -> (item2.Id_Commerce__c == item1.Id_Commerce__c)) == 0) or (sizeOf(vars.listLeadId filter (item2) -> ((item2.Id_Commerce__c == item1.Id_Commerce__c) and (STATUS contains item2.Status))) > 0)
]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="sfExtId"><![CDATA[%dw 2.0
output application/java
---
p('ecommerce.lead.sfExtId')]]></ee:set-variable>
				<ee:set-variable variableName="sfObject"><![CDATA[%dw 2.0
output application/java
---
p('ecommerce.lead.sfObject')]]></ee:set-variable>
				<ee:set-variable variableName="header"><![CDATA[%dw 2.0
output application/java
---
{
	"AssignmentRuleHeader": {
		"assignmentRuleId": "01Q3m000000ks8WEAQ"
	}
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="dataToSalesforce - Add RT" doc:id="9ae630a7-1bfb-44e0-a568-b89247e5c60e" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
payload map () -> ($ ++ {"RecordType": {"Name": "Prospecto VolcanPro"}})]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="sizeOf(dataToSalesforce)" doc:id="0bbb98ec-5606-4752-9dcf-64416039df12" message='#["Send to Salesforce - " ++ sizeOf(payload) ++ " Records"]' />
		<salesforce:upsert doc:name="Upsert" doc:id="f70241be-6eab-499b-8f70-bdff793c0983" config-ref="Salesforce_Config" objectType="#[vars.sfObject]" externalIdFieldName="#[vars.sfExtId]" target="dataToSalesforce" headers="#[vars.header]">
		</salesforce:upsert>
		<!-- [STUDIO:"Create"]<salesforce:create doc:name="Create" doc:id="79e18ce7-c669-4f84-b7ec-3e7fbcbaa060" config-ref="Salesforce_Config" type="#[vars.sfObject&#93;" headers="#[payload.headers&#93;" target="dataToSalesforce"/> [STUDIO] -->
		<ee:transform doc:name="JSON" doc:id="26f3956d-9dff-444f-8f79-0d666f3c200e">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map () -> (
    $ ++ {"Id": vars.dataToSalesforce.items[$$].payload.id default ""} ++ {"Status": vars.dataToSalesforce.items[$$].successful default ""} ++ {"Error": vars.dataToSalesforce.items[$$].message default ""}
)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
